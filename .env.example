# .env.example — Template for local environment configuration.
#
# Copy this file to `.env` and adjust values for your local setup:
#   cp .env.example .env
#
# `.env` is git-ignored and must never be committed. Every variable
# below corresponds directly to a field on
# `forecastforge.config.settings.Settings` and follows the
# FORECASTFORGE_<FIELD_NAME> naming convention. Any variable you leave
# commented out simply falls through to the TOML configuration
# (`configs/settings.toml` + `configs/<environment>.toml`) and then to
# the field default. See docs/development.md for the full
# configuration precedence order.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
FORECASTFORGE_ENV=development
# FORECASTFORGE_APP_NAME=forecastforge
# FORECASTFORGE_LOG_LEVEL=INFO
# FORECASTFORGE_RANDOM_SEED=42

# ---------------------------------------------------------------------------
# Paths (override to relocate local data/model/artifact workspaces)
# ---------------------------------------------------------------------------
# FORECASTFORGE_DATA_DIR=data
# FORECASTFORGE_MODELS_DIR=models
# FORECASTFORGE_ARTIFACTS_DIR=artifacts
# FORECASTFORGE_MLRUNS_DIR=mlruns

# ---------------------------------------------------------------------------
# Forecasting defaults
# ---------------------------------------------------------------------------
# FORECASTFORGE_DEFAULT_ASSET_SYMBOL=SPY
# FORECASTFORGE_DEFAULT_TIMEFRAME=1d
# FORECASTFORGE_SEQUENCE_LENGTH=64
# FORECASTFORGE_BATCH_SIZE=32
# FORECASTFORGE_NUM_WORKERS=4

# ---------------------------------------------------------------------------
# Compute device — one of: auto, cpu, cuda, mps
# ---------------------------------------------------------------------------
# FORECASTFORGE_DEVICE_PREFERENCE=auto

# ---------------------------------------------------------------------------
# Advanced overrides (rarely needed)
# ---------------------------------------------------------------------------
# Overrides project-root auto-detection (see
# forecastforge.config.paths.get_project_root). Useful in containers or
# non-editable installs where there is no source tree to search.
# FORECASTFORGE_PROJECT_ROOT=/absolute/path/to/forecastforge

# ---------------------------------------------------------------------------
# Reserved for future use (uncomment and populate when implemented)
# ---------------------------------------------------------------------------
# FORECASTFORGE_DATABASE_URL=
# FORECASTFORGE_MLFLOW_TRACKING_URI=
# FORECASTFORGE_API_HOST=0.0.0.0
# FORECASTFORGE_API_PORT=8000
