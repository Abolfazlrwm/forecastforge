# .env.example — Template for local environment configuration.
#
# Copy this file to `.env` and adjust values for your local setup:
#   cp .env.example .env
#
# `.env` is git-ignored and must never be committed. Values below are
# non-secret placeholders/defaults for the repository-bootstrap phase.
# Additional variables will be introduced as ingestion, training, and
# serving components are implemented.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
FORECASTFORGE_ENV=development
FORECASTFORGE_LOG_LEVEL=INFO
FORECASTFORGE_CONFIG_PATH=configs/settings.toml

# ---------------------------------------------------------------------------
# Paths (override to relocate local data/artifact workspaces)
# ---------------------------------------------------------------------------
FORECASTFORGE_DATA_DIR=data
FORECASTFORGE_MODELS_DIR=models
FORECASTFORGE_MLRUNS_DIR=mlruns

# ---------------------------------------------------------------------------
# Reserved for future use (uncomment and populate when implemented)
# ---------------------------------------------------------------------------
# FORECASTFORGE_DATABASE_URL=
# FORECASTFORGE_MLFLOW_TRACKING_URI=
# FORECASTFORGE_API_HOST=0.0.0.0
# FORECASTFORGE_API_PORT=8000
